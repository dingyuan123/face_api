# Runtime
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 开发环境允许局域网前端访问；生产环境必须改为 false 并配置明确来源。
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
APP_VERSION=0.1.0

# PostgreSQL
POSTGRES_DB=jianmianliao
POSTGRES_USER=jianmianliao
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication development settings
AUTH_TOKEN_SIGNING_KEY=replace-with-a-long-random-value
PHONE_HASH_KEY=replace-with-a-different-long-random-value
SMS_MOCK_SIGNING_KEY=replace-with-another-long-random-value
SMS_MOCK_ENABLED=true
# Development-only password login. Production always disables this endpoint.
ENABLE_DEV_PASSWORD_LOGIN=true
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
AUTH_ACCESS_TOKEN_LIFETIME=7200
AUTH_REFRESH_TOKEN_LIFETIME=2592000

# Identity and provider onboarding development settings
# Production must provide a secret-managed encryption key and disable Mock.
IDENTITY_ENCRYPTION_KEY=replace-with-a-fernet-compatible-long-random-key
IDENTITY_MOCK_ENABLED=true
PROVIDER_APPLICATION_MIN_LIFE_PHOTOS=3
PROVIDER_APPLICATION_MAX_LIFE_PHOTOS=9
PROVIDER_APPLICATION_INTRODUCTION_MIN_LENGTH=10
PROVIDER_APPLICATION_INTRODUCTION_MAX_LENGTH=500
MEDIA_ROOT=./var/media
MEDIA_URL=/api/v1/media/
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MIN_IMAGE_DIMENSION=64
MEDIA_MAX_IMAGE_DIMENSION=8000
MEDIA_MAX_IMAGE_PIXELS=20000000
MEDIA_URL_SIGNING_KEY=replace-with-a-long-random-signing-key
MEDIA_URL_SIGNING_KEY_VERSION=v1
MEDIA_DISPLAY_URL_TTL_SECONDS=600
MEDIA_DISPLAY_URL_REFRESH_BUFFER_SECONDS=30
PROFILE_DEFAULT_CITY_CODE=LZ
PROFILE_NICKNAME_MAX_LENGTH=30
PROFILE_SIGNATURE_MAX_LENGTH=100
PROFILE_INTEREST_TAG_MAX_COUNT=5
SCHEDULE_DEFAULT_TIMEZONE=Asia/Shanghai
SCHEDULE_SLOT_UNIT_MINUTES=60
SCHEDULE_DEFAULT_START_MINUTE=0
SCHEDULE_DEFAULT_END_MINUTE=1440
SCHEDULE_MAX_BOOKING_MINUTES=0
REFUND_REQUEST_MIN_HOURS_BEFORE_START=6
API_DISPLAY_TIMEZONE=Asia/Shanghai
SERVICE_TITLE_MAX_LENGTH=30
SERVICE_INTRODUCTION_MIN_LENGTH=10
SERVICE_INTRODUCTION_MAX_LENGTH=500
SERVICE_GALLERY_MIN_COUNT=1
SERVICE_GALLERY_MAX_COUNT=6
SERVICE_TAG_MAX_COUNT=8
HOME_FEED_GUEST_LIMIT=10
HOME_FEED_AUTHENTICATED_LIMIT=20
HOME_FEED_RECENT_PHOTO_COUNT=5
HOME_FEED_SERVICE_COUNT=3
# App 资讯分享落地页域名，只生成不携带身份或令牌的公开链接。
PUBLIC_SHARE_BASE_URL=https://app.example.com
# 生产或已启动 Celery Worker 时使用 true；本地无 Worker 可设 false 同步执行。
NEWS_SYNC_ASYNC=true
NEWS_FETCH_TIMEOUT_SECONDS=15
NEWS_FETCH_MAX_ITEMS=20
MOMENT_REVIEW_MODE=IMMEDIATE
MOMENT_CONTENT_MAX_LENGTH=2000
MOMENT_IMAGE_MIN_COUNT=1
MOMENT_IMAGE_MAX_COUNT=9
MOMENT_TAG_MAX_COUNT=5
PAYMENT_MODE=MOCK_BALANCE
ENABLE_DEV_WALLET_TOPUP=true
REVIEW_WINDOW_DAYS=7
REVIEW_AUTO_POSITIVE_ENABLED=false
PAYOUT_VERIFICATION_MODE=MOCK
PAYOUT_MODE=MOCK_MANUAL_REVIEW
WITHDRAWAL_MIN_AMOUNT_MINOR=1000
WITHDRAWAL_FEE_AMOUNT_MINOR=0
PROVIDER_INCOME_SETTLEMENT_DELAY_DAYS=0
PROVIDER_PLATFORM_COMMISSION_RATE_BPS=0

# Production-only required values:
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=...
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# POSTGRES_HOST=...
# POSTGRES_PASSWORD=...
# REDIS_URL=...
# AUTH_TOKEN_SIGNING_KEY=...
# PHONE_HASH_KEY=...
# IDENTITY_ENCRYPTION_KEY=...
# IDENTITY_MOCK_ENABLED=false
# MEDIA_URL_SIGNING_KEY=...
# PAYOUT_MODE=REAL
# PAYOUT_VERIFICATION_MODE=REAL

