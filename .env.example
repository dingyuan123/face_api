# Runtime
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 开发环境允许局域网前端访问；生产环境必须改为 false 并配置明确来源。
CORS_ALLOW_ALL_ORIGINS=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=false
APP_VERSION=0.1.0

# PostgreSQL
POSTGRES_DB=jianmianliao
POSTGRES_USER=jianmianliao
POSTGRES_PASSWORD=replace-with-a-local-development-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Authentication development settings
AUTH_TOKEN_SIGNING_KEY=replace-with-a-long-random-value
PHONE_HASH_KEY=replace-with-a-different-long-random-value
SMS_MOCK_SIGNING_KEY=replace-with-another-long-random-value
SMS_MOCK_ENABLED=true
# Development-only password login. Production always disables this endpoint.
ENABLE_DEV_PASSWORD_LOGIN=true
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
PASSWORD_LOGIN_MAX_FAILURES=5
PASSWORD_LOGIN_LOCK_SECONDS=900
AUTH_ACCESS_TOKEN_LIFETIME=7200
AUTH_REFRESH_TOKEN_LIFETIME=2592000

# Identity and provider onboarding development settings
# Production must provide a secret-managed encryption key and disable Mock.
IDENTITY_ENCRYPTION_KEY=replace-with-a-fernet-compatible-long-random-key
LOCATION_ENCRYPTION_KEY=replace-with-a-different-fernet-compatible-long-random-key
LOCATION_SELECTION_SIGNING_KEY=replace-with-a-long-random-location-signing-key
LOCATION_PROVIDER_TTL_SECONDS=86400
LOCATION_SELECTION_TTL_SECONDS=1800
IDENTITY_MOCK_ENABLED=true
PROVIDER_APPLICATION_MIN_LIFE_PHOTOS=3
PROVIDER_APPLICATION_MAX_LIFE_PHOTOS=9
PROVIDER_APPLICATION_INTRODUCTION_MIN_LENGTH=10
PROVIDER_APPLICATION_INTRODUCTION_MAX_LENGTH=500
MEDIA_ROOT=./var/media
MEDIA_URL=/api/v1/media/
MEDIA_MAX_UPLOAD_BYTES=5242880
MEDIA_MIN_IMAGE_DIMENSION=64
MEDIA_MAX_IMAGE_DIMENSION=8000
MEDIA_MAX_IMAGE_PIXELS=20000000
MEDIA_URL_SIGNING_KEY=replace-with-a-long-random-signing-key
MEDIA_URL_SIGNING_KEY_VERSION=v1
MEDIA_DISPLAY_URL_TTL_SECONDS=600
MEDIA_DISPLAY_URL_REFRESH_BUFFER_SECONDS=30
PROFILE_DEFAULT_CITY_CODE=LZ
PROFILE_NICKNAME_MAX_LENGTH=30
PROFILE_SIGNATURE_MAX_LENGTH=100
PROFILE_INTEREST_TAG_MAX_COUNT=5
ADMIN_CAPTCHA_ENABLED=true
# 推广奖励默认政策参数；正式比例必须由管理员创建不可变政策版本。
REFERRAL_REWARD_RATE_BPS=0
REFERRAL_REWARD_MAX_AMOUNT_MINOR=0
REFERRAL_REWARD_DELAY_DAYS=7
REFERRAL_REWARD_FUNDING_CAP_TO_PLATFORM_FEE=true
REFERRAL_VISIT_RETENTION_DAYS=180
SCHEDULE_DEFAULT_TIMEZONE=Asia/Shanghai
SCHEDULE_SLOT_UNIT_MINUTES=60
SCHEDULE_DEFAULT_START_MINUTE=0
SCHEDULE_DEFAULT_END_MINUTE=1440
SCHEDULE_MAX_BOOKING_MINUTES=0
REFUND_REQUEST_MIN_HOURS_BEFORE_START=6
API_DISPLAY_TIMEZONE=Asia/Shanghai
SERVICE_TITLE_MAX_LENGTH=30
SERVICE_INTRODUCTION_MIN_LENGTH=10
SERVICE_INTRODUCTION_MAX_LENGTH=500
SERVICE_GALLERY_MIN_COUNT=1
SERVICE_GALLERY_MAX_COUNT=6
SERVICE_TAG_MAX_COUNT=8
HOME_FEED_GUEST_LIMIT=10
HOME_FEED_AUTHENTICATED_LIMIT=20
HOME_FEED_RECENT_PHOTO_COUNT=5
HOME_FEED_SERVICE_COUNT=3
# App 资讯和个人主页分享落地页域名，只生成不携带访问令牌的公开链接。
PUBLIC_SHARE_BASE_URL=https://app.example.com
# 分享海报展示文案可通过环境变量调整；以下值仅为当前默认文案。
SHARE_POSTER_BRAND_NAME=FaceTo · 见面聊
SHARE_POSTER_BRAND_LABEL=你的见面破冰者
SHARE_POSTER_SLOGAN_LINE_1=想见面，
SHARE_POSTER_SLOGAN_LINE_2=却怕没话聊？
SHARE_POSTER_SLOGAN_SUBTITLE=从共同兴趣开始，让每次见面都有话聊。
SHARE_POSTER_CARD_FOOTER=先聊兴趣，再约公共场所见面
SHARE_POSTER_BOTTOM_SLOGAN=不必硬聊 · 兴趣就是你的破冰者
SHARE_POSTER_SHARE_TITLE=FaceTo · 见面聊｜你的见面破冰者
SHARE_POSTER_SHARE_DESCRIPTION=先聊兴趣，再约公共场所见面
# 生产或已启动 Celery Worker 时使用 true；本地无 Worker 可设 false 同步执行。
NEWS_SYNC_ASYNC=true
NEWS_FETCH_TIMEOUT_SECONDS=15
NEWS_FETCH_MAX_ITEMS=20
# 腾讯地图 WebService Key 只能保存在环境变量或密钥服务中，禁止提交真实 Key。
TENCENT_MAP_KEY=
TENCENT_MAP_API_BASE_URL=https://apis.map.qq.com/ws/place/v1/search
TENCENT_MAP_TIMEOUT_SECONDS=5
LOCATION_SEARCH_KEYWORD_MAX_LENGTH=50
LOCATION_SEARCH_RADIUS_DEFAULT_M=2000
LOCATION_SEARCH_RADIUS_MAX_M=5000
LOCATION_SEARCH_LIMIT_MAX=20
LOCATION_SEARCH_CACHE_TTL_SECONDS=30
MOMENT_REVIEW_MODE=IMMEDIATE
MOMENT_CONTENT_MAX_LENGTH=2000
MOMENT_IMAGE_MIN_COUNT=1
MOMENT_IMAGE_MAX_COUNT=9
MOMENT_TAG_MAX_COUNT=5

# 订单实时聊天
MESSAGING_WS_TICKET_TTL_SECONDS=60
MESSAGING_MESSAGE_MAX_LENGTH=2000
MESSAGING_COMPLETED_SEND_WINDOW_DAYS=7
MESSAGING_RECORD_RETENTION_DAYS=180
MESSAGING_MAX_PAGE_SIZE=100
PAYMENT_MODE=MOCK_BALANCE
# 外部支付适配模式：MOCK 只用于开发联调；真实微信/支付宝联调和生产改为 REAL。
PAYMENT_GATEWAY_MODE=MOCK
PAYMENT_CURRENCY=CNY
PAYMENT_CLIENT_PAYLOAD_TTL_SECONDS=600
ENABLE_DEV_WALLET_TOPUP=true
REVIEW_WINDOW_DAYS=7
REVIEW_AUTO_POSITIVE_ENABLED=false
PAYOUT_VERIFICATION_MODE=MOCK
PAYOUT_MODE=MOCK_MANUAL_REVIEW
WITHDRAWAL_MIN_AMOUNT_MINOR=1000
WITHDRAWAL_FEE_AMOUNT_MINOR=0
PROVIDER_INCOME_SETTLEMENT_DELAY_DAYS=0
PROVIDER_PLATFORM_COMMISSION_RATE_BPS=1000

# 微信 App 登录（仅 App，不开放网页登录）
WECHAT_LOGIN_ENABLED=true
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_API_BASE_URL=https://api.weixin.qq.com
WECHAT_LOGIN_TIMEOUT_SECONDS=5

# Sign in with Apple（仅 iOS App）
APPLE_LOGIN_ENABLED=true
APPLE_CLIENT_ID=
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_JWKS_TIMEOUT_SECONDS=5

# 微信支付 App 支付；开发 MOCK 模式可留空，真实联调必须从密钥服务读取
WECHAT_PAY_MCH_ID=
WECHAT_PAY_APP_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify/
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
WECHAT_PAY_TIMEOUT_SECONDS=8

# 支付宝 App 支付；密钥支持 PEM、Base64 DER 或本地密钥文件路径
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/alipay/notify/
ALIPAY_GATEWAY_URL=https://openapi.alipay.com/gateway.do
ALIPAY_TIMEOUT_SECONDS=8

# Production-only required values:
# DJANGO_ENV=production
# DJANGO_SECRET_KEY=...
# DJANGO_ALLOWED_HOSTS=api.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://api.example.com
# POSTGRES_HOST=...
# POSTGRES_PASSWORD=...
# REDIS_URL=...
# AUTH_TOKEN_SIGNING_KEY=...
# PHONE_HASH_KEY=...
# IDENTITY_ENCRYPTION_KEY=...
# LOCATION_ENCRYPTION_KEY=...
# LOCATION_SELECTION_SIGNING_KEY=...
# IDENTITY_MOCK_ENABLED=false
# MEDIA_URL_SIGNING_KEY=...
# PAYOUT_MODE=REAL
# PAYOUT_VERIFICATION_MODE=REAL
# TENCENT_MAP_KEY=...
# PAYMENT_GATEWAY_MODE=REAL
# PAYMENT_MODE=REAL
# WECHAT_LOGIN_APP_ID=...
# WECHAT_LOGIN_APP_SECRET=...
# APPLE_CLIENT_ID=...
# WECHAT_PAY_MCH_ID=...
# WECHAT_PAY_APP_ID=...
# WECHAT_PAY_API_V3_KEY=...
# WECHAT_PAY_MERCHANT_SERIAL_NO=...
# WECHAT_PAY_PRIVATE_KEY=...
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=...
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=...
# WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/v1/payments/wechat/notify/
# ALIPAY_APP_ID=...
# ALIPAY_PRIVATE_KEY=...
# ALIPAY_PUBLIC_KEY=...
# ALIPAY_NOTIFY_URL=https://api.example.com/api/v1/payments/alipay/notify/

